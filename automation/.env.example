# Stickman Survival Stories — API Keys and Configuration
# ЕСКЕРТУ: толтырып, .env етіп осы папкаға сақтаңыз. .gitignore-де, GitHub-қа жүктелмейді.

GEMINI_API_KEY=

# Edge TTS дауысы (тегін, кілт керек емес)
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Telegram хабарламалары
TELEGRAM_NOTIFY_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# YouTube параметрлері (1 = Film & Animation)
YOUTUBE_CATEGORY_ID=1
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_MADE_FOR_KIDS=false

# Сахна саны (env/pose тіркесімдерін қайталамай осы аралықта ұстайды)
MIN_BEATS=10
MAX_BEATS=15

# Қайтара сынау параметрлері
MAX_RETRIES=3
RETRY_DELAY=2
